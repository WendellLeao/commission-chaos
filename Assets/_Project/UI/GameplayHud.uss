.root {
    flex-grow: 1;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.score-bar {
    position: absolute;
    top: 24px;
    left: 0;
    right: 0;
    align-items: center;
}

.score-label {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(240, 240, 240);
    -unity-text-align: middle-center;
    background-color: rgba(20, 20, 24, 0.6);
    padding: 8px 24px;
    border-radius: 8px;
}

.win-panel {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.7);
}

.win-panel-box {
    align-items: center;
    justify-content: center;
    background-color: rgb(45, 45, 52);
    padding: 40px 64px;
    border-radius: 12px;
}

.win-label {
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(255, 215, 0);
    -unity-text-align: middle-center;
}
